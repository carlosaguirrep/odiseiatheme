{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"settings": {
		"border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		},
		"color": {
			"palette": [
				{
					"color": "#3563E9",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#F7F9FE",
					"name": "Secondary",
					"slug": "secondary"
				},
				{
					"color": "#211C2D",
					"name": "Therd",
					"slug": "therd"
				}
			]
		},
		"layout": {
			"contentSize": "926px",
			"wideSize": "1200px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"margin": true,
			"padding": true,
			"spacingSizes": [
				{
					"name": "Smaller",
					"size": "1rem",
					"slug": "small"
				},
				{
					"name": "Medium",
					"size": "2rem",
					"slug": "medium"
				},
				{
					"name": "Large",
					"size": "4rem",
					"slug": "large"
				},
				{
					"name": "Extra Large",
					"size": "8rem",
					"slug": "extralarge"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
					"name": "System Font",
					"slug": "system-font"
				},
				{
					"fontFace": [],
					"fontFamily": "Inter, sans-serif",
					"name": "Inter",
					"slug": "inter"
				}
			],
			"fontSizes": [
				{
					"name": "Extra small",
					"size": ".9rem",
					"slug": "extra-small"
				},
				{
					"name": "Small",
					"size": ".11rem",
					"slug": "small"
				},
				{
					"name": "Regular",
					"size": "1rem",
					"slug": "regular"
				},
				{
					"name": "Medium",
					"size": "1.25rem",
					"slug": "medium"
				},
				{
					"fluid": false,
					"name": "Extra large",
					"size": "4rem",
					"slug": "large"
				}
			],
			"textDecoration": false
		}
	},
	"styles": {
		"blocks": {
			"core/button": {
				"border": {
					"radius": "5px"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)"
				},
				"shadow": "var(--wp--preset--shadow--natural)",
				"typography": {
					"fontSize": "var(--wp--preset--font-size--regular)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--extra-small)"
				}
			}
		},
		"css": "p { line-height:1.8rem;}\n\na {text-decoration:none}\n\na:hover{opacity:.5}",
		"elements": {
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "2.9rem"
				}
			}
		},
		"spacing": {
			"padding": {
				"bottom": "0px",
				"left": "0px",
				"right": "0px",
				"top": "0px"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--medium)"
		}
	},
	"version": 3
}